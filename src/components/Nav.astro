---
import { siteConfig } from "../config";
const base = import.meta.env.BASE_URL;
---

<header class="nav">
  <div class="container nav-inner">
    <a class="wordmark" href={`${base}#top`}>
      <span class="mark" aria-hidden="true">A</span>
      Apptivate
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
      <span class="sr-only">Menu</span>
      <span></span>
      <span></span>
    </button>
    <nav id="nav-links" class="nav-links">
      <a href={`${base}#services`}>Services</a>
      <a href={`${base}#how`}>How it works</a>
      <a href={`${base}#work`}>Work</a>
      <a href={`${base}#about`}>About</a>
      <a href={`${base}#contact`}>Contact</a>
      <a class="btn btn-primary nav-cta" href={siteConfig.bookingUrl} target="_blank" rel="noopener">Book a call</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const links = document.querySelector("#nav-links");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    links?.classList.toggle("is-open", !open);
  });
  links?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      links.classList.remove("is-open");
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(11, 18, 32, 0.92);
    backdrop-filter: blur(12px);
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-h);
    gap: 1rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    font-size: 1.15rem;
    text-decoration: none;
    margin: 0;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 7px;
    background: var(--accent-grad);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .nav-links a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.86);
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 160ms ease;
  }

  .nav-links a:hover {
    color: #fff;
  }

  .nav-cta {
    color: #fff;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 0;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    background: #fff;
    margin: 5px 0;
  }

  @media (max-width: 719px) {
    .nav-toggle {
      display: block;
    }

    .nav-links {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: var(--nav-h);
      background: #0b1220;
      flex-direction: column;
      align-items: stretch;
      padding: 1rem clamp(1rem, 4vw, 2.5rem) 1.25rem;
    }

    .nav-links.is-open {
      display: flex;
    }
  }
</style>
