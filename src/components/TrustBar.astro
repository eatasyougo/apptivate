---
const names = ["Citi", "Man Group", "BNP Paribas", "Virtuetech"];
---

<section class="trust" aria-label="Experience delivering for">
  <div class="container trust-inner">
    <p>Experience delivering for</p>
    <ul>
      {names.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</section>

<style>
  .trust {
    background: var(--ink-2);
    color: rgba(255, 255, 255, 0.72);
    padding: 1.1rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .trust-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }

  p {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    font-weight: 700;
    color: #c9d0dc;
    letter-spacing: -0.02em;
  }
</style>
