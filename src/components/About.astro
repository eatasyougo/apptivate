---
import { Image } from "astro:assets";
import ajay from "../assets/ajay.jpg";
---

<section class="section section--surface" id="about">
  <div class="container about">
    <div>
      <p class="eyebrow">About</p>
      <h2>Ajay Prince</h2>
      <p class="pull">Senior judgement. A team that ships.</p>
      <p>
        I've spent 15+ years on trading, risk and investment systems at BNP Paribas, Man Group and
        Citi — including a VP role on Citi Velocity — and I now work on an internal financial-products
        web app for Marex, through Virtuetech. I founded Apptivate in 2015 as a .NET trading and risk consultancy. It's now
        the vehicle for that same senior judgement, aimed at funded startups that need a technical
        partner without a full-time London CTO.
      </p>
      <p>
        I'm based in London and work full-stack across React and TypeScript, .NET and C#, Node, and
        hands-on AI and LLM integration. Delivery is led from the UK and built with a trusted team
        in Chennai, India, so you get senior direction and a cost-effective build.
      </p>
      <ul class="creds">
        <li><strong>20+ years</strong> engineering</li>
        <li>ex-Citi, Man Group, BNP Paribas</li>
        <li>London, UK</li>
      </ul>
    </div>
    <div class="photo">
      <span class="ring">
        <Image
          src={ajay}
          alt="Ajay Prince, founder of Apptivate"
          width={800}
          height={800}
          loading="lazy"
        />
      </span>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 2rem;
  }

  .pull {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink);
    letter-spacing: -0.03em;
  }

  .creds {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .creds li {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .photo {
    display: grid;
    justify-items: center;
    align-content: center;
  }

  .ring {
    width: min(16rem, 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 4px;
    background: var(--accent-grad);
    box-shadow: 0 16px 40px rgba(47, 107, 255, 0.25);
    display: grid;
    overflow: hidden;
  }

  .ring :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 18%;
    border-radius: 50%;
  }

  @media (min-width: 720px) {
    .about {
      grid-template-columns: 1.6fr 0.8fr;
      align-items: center;
    }
  }
</style>
