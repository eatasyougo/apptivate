---
interface Props {
  title?: string;
}
const { title = "apptivate.uk" } = Astro.props;
---

<figure class="browser">
  <div class="chrome" aria-hidden="true">
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="title">{title}</span>
  </div>
  <div class="viewport">
    <slot />
  </div>
</figure>

<style>
  .browser {
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    background: #0e1628;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.2),
      0 24px 50px rgba(0, 0, 0, 0.35);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.8rem;
    background: #161f32;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3d4a63;
  }

  .dot:nth-child(1) {
    background: #ff5f57;
  }
  .dot:nth-child(2) {
    background: #febc2e;
  }
  .dot:nth-child(3) {
    background: #28c840;
  }

  .title {
    margin-left: 0.5rem;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .viewport :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
