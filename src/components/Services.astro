---
import { siteConfig } from "../config";

const services = [
  {
    n: "01",
    title: "Fractional CTO & Technical Advisory",
    best: "Best for: founders who need a senior technical partner, not a hire yet.",
    body: "Architecture, tech strategy, hiring, code and vendor review, and de-risking your roadmap.",
    icon: "advisory",
  },
  {
    n: "02",
    title: "MVP & Product Build",
    best: "Best for: turning a funded idea into a shipped first product.",
    body: "From idea to shipped product, built by a focused delivery team with senior oversight.",
    icon: "build",
  },
  {
    n: "03",
    title: "AI & LLM Integration",
    best: "Best for: adding practical AI to a real product, not a demo.",
    body: "Natural-language querying, RAG, conversational UI, and LLM features that actually ship.",
    icon: "ai",
  },
  {
    n: "04",
    title: "Team Augmentation",
    best: "Best for: extra engineering capacity without London rates.",
    body: "A cost-effective Chennai-based engineering team, led and quality-controlled from the UK.",
    icon: "team",
  },
];
---

<section class="section" id="services">
  <div class="container">
    <p class="eyebrow">Services</p>
    <h2>How Apptivate helps</h2>
    <p>UK-based senior leadership, with hands to build — without a London agency price tag.</p>
    <div class="grid-4" style="margin-top: 2rem;">
      {
        services.map((item) => (
          <article class="card svc reveal">
            <span class="num">{item.n}</span>
            <span class="icon" aria-hidden="true">
              {item.icon === "advisory" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
              )}
              {item.icon === "build" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <rect x="3" y="4" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="4" width="7" height="7" rx="1.5"></rect>
                  <rect x="3" y="13" width="7" height="7" rx="1.5"></rect>
                  <path d="M17.5 13.5v6.5M14 17h7"></path>
                </svg>
              )}
              {item.icon === "ai" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path d="M12 3l1.4 4.2L18 8.6l-4.2 1.4L12 14l-1.4-4L7 8.6l4.6-1.4L12 3z"></path>
                  <circle cx="18.5" cy="17.5" r="2.5"></circle>
                  <path d="M5 16.5h5"></path>
                </svg>
              )}
              {item.icon === "team" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <circle cx="8" cy="9" r="3"></circle>
                  <circle cx="16.5" cy="10" r="2.5"></circle>
                  <path d="M2.5 19c.6-3 3-5 5.5-5s4.9 2 5.5 5"></path>
                  <path d="M13 19c.4-2.2 2-3.8 4-3.8 2.2 0 3.8 1.6 4.3 3.8"></path>
                </svg>
              )}
            </span>
            <h3>{item.title}</h3>
            <p class="best">{item.best}</p>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
    <p class="soft-cta">
      Not sure where to start? <a href={siteConfig.bookingUrl} target="_blank" rel="noopener">Book a free intro call →</a>
    </p>
  </div>
</section>

<style>
  .svc {
    padding: 1.7rem 1.5rem 1.5rem;
  }

  .num {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--surface);
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  h3 {
    font-size: 1.1rem;
    margin-bottom: 0.45rem;
    padding-right: 2rem;
  }

  .best {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.45rem;
  }
</style>
