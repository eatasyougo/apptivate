---
const quotes = [
  {
    text: "TODO: replace with a real testimonial from a founder you’ve helped.",
    name: "TODO — Name",
    role: "Founder, stealth fintech",
  },
  {
    text: "TODO: a second short quote on senior guidance, delivery, or AI work.",
    name: "TODO — Name",
    role: "CTO, seed-stage SaaS",
  },
];
---

<section class="section section--surface" id="testimonials" aria-labelledby="quotes-heading">
  <div class="container">
    <p class="eyebrow">What founders say</p>
    <h2 id="quotes-heading">Testimonials</h2>
    <p class="note">Placeholder quotes — swap in real names and words when you have them.</p>
    <div class="grid-2" style="margin-top: 1.5rem;">
      {
        quotes.map((q) => (
          <blockquote class="card quote reveal">
            <span class="mark" aria-hidden="true">“</span>
            <p>{q.text}</p>
            <footer>
              <cite>{q.name}</cite>
              <span>{q.role}</span>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<style>
  .note {
    font-size: 0.9rem;
  }

  .quote {
    padding: 2rem 1.5rem 1.5rem;
  }

  .mark {
    display: block;
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 0.7;
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 0.75rem;
  }

  .quote p {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.4;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  footer {
    display: grid;
    gap: 0.15rem;
  }

  cite {
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
  }

  footer span {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
