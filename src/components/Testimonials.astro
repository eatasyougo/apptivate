---
const quotes = [
  {
    text: "Ajay has the rare ability to deliver technical solutions, whilst building strong relationships with key business stakeholders.",
    name: "Paul Garrett",
    role: "CEO, Radley James",
  },
  {
    text: "Not just a manager but a mentor. His strategic insights helped streamline operations and enhance our product offerings as we grew from a small startup.",
    name: "Hari Pravin M J G",
    role: "Solution Architect · worked together at ecSoftware",
  },
  {
    text: "A friendly and collaborative team player, an excellent problem-solver, and always willing to keep up with the latest tech. I would not hesitate to recommend him.",
    name: "Schalk Pienaar",
    role: "Software Engineer & Architect · Commerzbank",
  },
];
---

<section class="section section--surface" id="testimonials" aria-labelledby="quotes-heading">
  <div class="container">
    <p class="eyebrow">Recommendations</p>
    <h2 id="quotes-heading">What colleagues say</h2>
    <div class="grid-3" style="margin-top: 1.5rem;">
      {
        quotes.map((q) => (
          <blockquote class="card quote reveal">
            <span class="mark" aria-hidden="true">“</span>
            <p>{q.text}</p>
            <footer>
              <cite>{q.name}</cite>
              <span>{q.role}</span>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<style>
  .quote {
    padding: 2rem 1.5rem 1.5rem;
  }

  .mark {
    display: block;
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 0.7;
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 0.75rem;
  }

  .quote p {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  footer {
    display: grid;
    gap: 0.15rem;
  }

  cite {
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
  }

  footer span {
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
