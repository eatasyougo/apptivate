---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
import velocity from "../assets/work/velocity.png";
import BrowserFrame from "./BrowserFrame.astro";
---

<section class="hero" id="top">
  <div class="glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="copy">
      <p class="eyebrow">Apptivate · London</p>
      <h1>
        Senior engineering leadership for startups — <span class="grad">plus a team to build it.</span>
      </h1>
      <p class="lead">
        I'm Ajay Prince. I've spent 20 years building trading and risk systems for banks like Citi,
        Man Group and BNP Paribas. Apptivate gives early-stage founders that same senior guidance —
        as your fractional CTO and technical partner — backed by a cost-effective delivery team.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={siteConfig.bookingUrl} target="_blank" rel="noopener">Book a free intro call</a>
        <a class="btn-ghost" href="#how">See how I work →</a>
      </div>
      <ul class="stats">
        <li><strong>20+ yrs</strong> shipping production systems</li>
        <li><strong>ex-Citi · Man Group · BNP Paribas</strong></li>
        <li><strong>UK-led</strong>, Chennai-built</li>
      </ul>
    </div>
    <div class="hero-visual">
      <div class="tilt">
        <BrowserFrame title="Citi Velocity">
          <Image
            src={velocity}
            alt="Citi Velocity trading platform with live FX prices, charts and order blotters."
            width={975}
            height={652}
            loading="eager"
          />
        </BrowserFrame>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(1200px 500px at 10% -10%, rgba(47, 107, 255, 0.28), transparent 55%),
      radial-gradient(900px 420px at 90% 10%, rgba(106, 92, 255, 0.22), transparent 50%),
      var(--ink);
    color: #fff;
    padding: 4rem 0 3.5rem;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.35;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    z-index: 0;
    width: 28rem;
    height: 28rem;
    right: -6rem;
    top: -8rem;
    background: var(--glow);
    filter: blur(80px);
    pointer-events: none;
  }

  .hero-grid,
  .copy {
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  h1 {
    letter-spacing: -0.04em;
    color: #fff;
  }

  .copy :global(.grad) {
    background: linear-gradient(135deg, #9ec0ff 0%, #d0c6ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    font-size: 1.05rem;
    max-width: 40rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }

  .btn-ghost {
    color: rgba(255, 255, 255, 0.9);
  }

  .stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin: 1.75rem 0 0;
    padding: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.9rem;
  }

  .stats strong {
    color: #fff;
    font-weight: 700;
  }

  .hero-visual {
    display: none;
  }

  .tilt {
    transform: rotate(-1.5deg);
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.4));
  }

  @media (min-width: 900px) {
    .hero {
      padding: 6rem 0 5.5rem;
    }

    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .hero-visual {
      display: block;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .copy {
      animation: rise 700ms ease both;
    }

    .tilt {
      animation: rise-tilt 900ms 80ms ease both;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(14px);
    }
    to {
      transform: none;
    }
  }

  @keyframes rise-tilt {
    from {
      transform: translateY(18px) rotate(-1.5deg);
    }
    to {
      transform: rotate(-1.5deg);
    }
  }
</style>
