---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const gid = `apptivate-g-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  width="32"
  height="32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={gid} x1="4" y1="28" x2="28" y2="4" gradientUnits="userSpaceOnUse">
      <stop stop-color="#2f6bff"></stop>
      <stop offset="1" stop-color="#6a5cff"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill={`url(#${gid})`}></rect>
  <!-- Peak = A / activation; node on the bar = “go live” -->
  <path
    d="M8.2 23.6 L16 8.4 L23.8 23.6"
    stroke="#fff"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path d="M11.4 17.4 H20.6" stroke="#fff" stroke-width="2.6" stroke-linecap="round"></path>
  <circle cx="16" cy="17.4" r="2.15" fill="#fff"></circle>
  <circle cx="16" cy="17.4" r="0.85" fill="#3d5bff"></circle>
</svg>

<style>
  svg {
    width: 1.85rem;
    height: 1.85rem;
    display: block;
    flex-shrink: 0;
  }
</style>
