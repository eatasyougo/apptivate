---
import { siteConfig } from "../config";
import LogoMark from "./LogoMark.astro";
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer>
  <div class="container foot">
    <p class="brand">
      <LogoMark class="foot-mark" />
      {siteConfig.legalName} · Company no. {siteConfig.companyNumber} · Registered in England &amp; Wales
    </p>
    <p>
      <a href={`${base}privacy/`}>Privacy</a>
      ·
      <a href={`${base}cookies/`}>Cookies</a>
      · © {year}
    </p>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.72);
    padding: 2rem 0 2.5rem;
    font-size: 0.9rem;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .foot-mark {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  p {
    margin: 0;
    color: inherit;
  }

  a {
    color: #fff;
    text-decoration: none;
  }
</style>
