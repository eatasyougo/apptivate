---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
import velocity from "../assets/work/velocity.png";
import brokeflyer from "../assets/work/brokeflyer.png";
import icelandTours from "../assets/work/iceland-tours.png";
import designtorget from "../assets/work/designtorget.png";
import ecshopping from "../assets/work/ecshopping.png";
import BrowserFrame from "./BrowserFrame.astro";

const earlier = [
  { src: icelandTours, alt: "Iceland Tours booking website", caption: "Iceland Tours" },
  { src: designtorget, alt: "DesignTorget product page", caption: "DesignTorget" },
  { src: ecshopping, alt: "Icelandic e-commerce product page", caption: "ecShopping" },
];
---

<section class="section" id="work">
  <div class="container">
    <p class="eyebrow">Portfolio</p>
    <h2>Selected work</h2>

    <article class="case reveal">
      <BrowserFrame title="Citi Velocity">
        <Image
          src={velocity}
          alt="Citi Velocity commodities trading platform with prices, charts and an order blotter."
          width={975}
          height={652}
          loading="lazy"
        />
      </BrowserFrame>
      <div>
        <h3>Citi Velocity</h3>
        <p class="impact">Globally deployed commodities trading platform.</p>
        <p>
          I contributed to migrating the client-facing desktop/web hybrid to a pure web application
          using React, Recoil, WAMP and Python.
        </p>
        <ul class="pills">
          <li>React</li>
          <li>Recoil</li>
          <li>WAMP</li>
          <li>Python</li>
        </ul>
      </div>
    </article>

    <article class="case case-flip reveal">
      <BrowserFrame title="brokeflyer.com">
        <Image
          src={brokeflyer}
          alt="BrokeFlyer: cheap flight deals from London, with live deal cards and trip tools."
          width={1280}
          height={800}
          loading="lazy"
        />
      </BrowserFrame>
      <div>
        <h3>BrokeFlyer</h3>
        <p class="impact">My own product — live at <a href="https://brokeflyer.com" target="_blank" rel="noopener">brokeflyer.com</a>.</p>
        <p>
          A flight-deals site that finds cheap fares from London. Still being built, but it works for
          the most part: live deals, trip tools, and an end-to-end product I designed, shipped and run.
          The clearest proof I can take something from idea to production, not only contribute inside a bank.
        </p>
        <ul class="pills">
          <li>Founder-built</li>
          <li>Live product</li>
          <li>Work in progress</li>
        </ul>
      </div>
    </article>

    <article class="card case-text reveal">
      <h3>Virtuetech — AI financial-products platform</h3>
      <p class="impact">Natural-language querying over structured financial data.</p>
      <p>
        Conversational grid customisation, product and trade lifecycle, a Node/Express BFF, and RAG
        so users can ask for what they need in plain language.
      </p>
      <ul class="pills">
        <li>React</li>
        <li>TypeScript</li>
        <li>AG Grid</li>
        <li>Node BFF</li>
        <li>Elasticsearch</li>
        <li>RAG</li>
      </ul>
    </article>

    <div class="earlier">
      <p>20 years of delivery — selected earlier web &amp; e-commerce work</p>
      <div class="scroller">
        {
          earlier.map((item) => (
            <figure>
              <Image src={item.src} alt={item.alt} width={487} height={512} loading="lazy" />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <p class="soft-cta">
      Want something like this for your product? <a href={siteConfig.bookingUrl} target="_blank" rel="noopener">Book a call →</a>
    </p>
  </div>
</section>

<style>
  .case {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    align-items: center;
  }

  .case-text {
    margin-top: 1.25rem;
  }

  .case a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .case a:hover {
    text-decoration: underline;
  }

  h3 {
    font-size: 1.35rem;
  }

  .earlier {
    margin-top: 2.5rem;
  }

  .earlier > p {
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
  }

  .scroller {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  figure {
    margin: 0;
    min-width: 0;
    position: relative;
  }

  figure img {
    width: 100%;
    height: 10rem;
    object-fit: cover;
    object-position: top;
    border-radius: 10px;
    border: 1px solid var(--line);
    filter: grayscale(0.4);
    opacity: 0.8;
    transition: filter 160ms ease, opacity 160ms ease;
  }

  figcaption {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.5rem;
    background: rgba(11, 18, 32, 0.78);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 8px;
    opacity: 0;
    transition: opacity 160ms ease;
  }

  figure:hover img,
  figure:focus-within img {
    filter: none;
    opacity: 1;
  }

  figure:hover figcaption,
  figure:focus-within figcaption {
    opacity: 1;
  }

  @media (min-width: 720px) {
    .case {
      grid-template-columns: 1.25fr 1fr;
    }

    .case-flip {
      grid-template-columns: 1fr 1.25fr;
    }

    .case-flip > :first-child {
      order: 2;
    }

    .scroller {
      grid-template-columns: repeat(3, 1fr);
    }

    figure img {
      height: 11.5rem;
    }
  }
</style>
