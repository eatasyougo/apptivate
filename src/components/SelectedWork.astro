---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
import velocity from "../assets/work/velocity.png";
import brokeflyer from "../assets/work/brokeflyer.png";
import productsPlatform from "../assets/work/products-platform.jpg";
import BrowserFrame from "./BrowserFrame.astro";
---

<section class="section" id="work">
  <div class="container">
    <p class="eyebrow">Portfolio</p>
    <h2>Selected work</h2>

    <article class="case reveal">
      <div class="media">
        <BrowserFrame title="Citi Velocity">
          <Image
            src={velocity}
            alt="Citi Velocity commodities trading platform with prices, charts and an order blotter."
            width={1280}
            height={800}
            loading="lazy"
          />
        </BrowserFrame>
      </div>
      <div class="copy">
        <h3>Citi Velocity</h3>
        <p class="impact">Globally deployed commodities trading platform.</p>
        <p>
          I contributed to migrating the client-facing desktop/web hybrid to a pure web application
          using React, Recoil, WAMP and Python.
        </p>
        <ul class="pills">
          <li>React</li>
          <li>Recoil</li>
          <li>WAMP</li>
          <li>Python</li>
        </ul>
      </div>
    </article>

    <article class="case case-flip reveal">
      <div class="media">
        <BrowserFrame title="brokeflyer.com">
          <Image
            src={brokeflyer}
            alt="BrokeFlyer: live cheap-flight deals from London, scored and listed as trips you can actually take."
            width={1280}
            height={800}
            loading="lazy"
          />
        </BrowserFrame>
      </div>
      <div class="copy">
        <h3>BrokeFlyer</h3>
        <p class="impact">
          Not cheaper tickets — a cheap cell on a chart versus a trip you can take on Thursday night.
        </p>
        <p>
          Google Flights is a price board, not an answer to “when can I go?” BrokeFlyer treats it as a live
          dataset: score fares against what that route should cost, then keep only itineraries that fit a
          real job. We find the trip; booking stays on Google.
          Live at <a href="https://brokeflyer.com" target="_blank" rel="noopener">brokeflyer.com</a> —
          still being built, but the engine is live.
        </p>
        <ul class="pills">
          <li>Founder-built</li>
          <li>Live product</li>
          <li>Work in progress</li>
        </ul>
      </div>
    </article>

    <article class="case reveal">
      <div class="media media-scene">
        <Image
          src={productsPlatform}
          alt="Generic desktop mock of an internal financial-products web app: catalogue grid and natural-language search."
          width={1280}
          height={720}
          loading="lazy"
        />
      </div>
      <div class="copy">
        <h3>Internal products platform</h3>
        <p class="impact">Capital-markets client — engagement via Virtuetech.</p>
        <p>
          Natural-language querying over structured data, conversational grid customisation, product
          and trade lifecycle, a Node/Express BFF, and RAG.
        </p>
        <ul class="pills">
          <li>React</li>
          <li>TypeScript</li>
          <li>AG Grid</li>
          <li>Node BFF</li>
          <li>Elasticsearch</li>
          <li>RAG</li>
        </ul>
      </div>
    </article>

    <p class="soft-cta">
      Want something like this for your product? <a href={siteConfig.bookingUrl} target="_blank" rel="noopener">Book a call →</a>
    </p>
  </div>
</section>

<style>
  .case {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.25rem;
    align-items: center;
  }

  .media {
    min-width: 0;
    aspect-ratio: 16 / 10;
  }

  .media :global(.browser) {
    height: 100%;
  }

  .media-scene {
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 16px;
    background: #eef1f6;
    border: 1px solid var(--line);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 18px 40px rgba(11, 18, 32, 0.12);
  }

  .media-scene :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .copy h3 {
    font-size: 1.35rem;
    margin-bottom: 0.45rem;
  }

  .copy p {
    margin-bottom: 0.75rem;
  }

  .copy a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .copy a:hover {
    text-decoration: underline;
  }

  .soft-cta {
    margin-top: 2.25rem;
  }

  @media (min-width: 800px) {
    .case {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
    }

    .case-flip > .media {
      order: 2;
    }
  }
</style>
